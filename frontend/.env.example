# Public API URL — the Q-Trust Fastify backend.
# In production this is your hosted backend (e.g. https://api.qtrust.dev).
# Public API origin used for documentation links and as the local proxy fallback.
NEXT_PUBLIC_QTRUST_API_URL=http://localhost:3001

# Server-only Fastify origin used by the Next.js /api/* proxy.
# Do not prefix this variable with NEXT_PUBLIC_ or it will be bundled for browsers.
QTRUST_BACKEND_URL=http://localhost:3001
# Server-only key forwarded by the proxy to protected backend routes.
QTRUST_API_KEY=

# Public IPFS gateway for fetching CBOM metadata.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# WalletConnect project ID — required by RainbowKit/wagmi for wallet connections.
# Create one free at https://cloud.walletconnect.com. The placeholder below keeps
# non-production builds compiling; the production build fails fast when the value
# is unset or literally "demo" (audit F-2), and real wallet connections are
# rate-limited without a valid project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=00000000000000000000000000000000

# Chain selection: leave unset/empty for Base Sepolia (default); set to "true"
# to target Base mainnet. Must match where QTRUST_VENDOR_REGISTRY_ADDRESS etc.
# are deployed.
QTRUST_USE_MAINNET=
